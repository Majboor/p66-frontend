# Origin of the order gateway (the service that fronts the restaurant backend,
# terminates CORS, recomputes prices and mints order tokens).
#
# Leave it empty to call the gateway on the same origin as the site, which is
# what the dev server proxies to VITE_API_TARGET and what a reverse proxy or a
# Pages Function in front of /api/* would serve. Set it to the gateway's own
# origin when the gateway is hosted separately.
VITE_ORDER_API=

# Dev-server-only: where `vite dev` proxies /api, /health and /exports.
VITE_API_TARGET=http://localhost:3000
